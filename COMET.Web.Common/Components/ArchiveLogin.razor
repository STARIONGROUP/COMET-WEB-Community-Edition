@namespace COMET.Web.Common.Components
@using Blazored.FluentValidation
@inherits DisposableComponent

<EditForm Context="editFormContext" Model="@this.ViewModel.AuthenticationDto" OnValidSubmit="this.ExecuteLogin" id="archive-login-form" data-app-ready="@(this.formReady ? "true" : null)">
    <FluentValidationValidator/>
    <DxFormLayout CaptionPosition="CaptionPosition.Vertical">
        <DxFormLayoutItem Caption="Archive:" ColSpanLg="12">
            <Template>
                <FileDropZone Id="archive-drop-zone"
                              Accept=".zip"
                              Placeholder="Drop an Annex C3 archive here, or click to browse"
                              SelectedFile="@(this.ViewModel.SelectedFile)"
                              SelectedFileChanged="@(file => this.ViewModel.SelectedFile = file)"/>
            </Template>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="Username:" BeginRow="true" ColSpanLg="12">
            <Template>
                <DxTextBox Id="archive-username" @bind-Text="@(this.ViewModel.AuthenticationDto.UserName)"
                           ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                           NullText="Enter your username"/>
            </Template>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="Password:" BeginRow="true" ColSpanLg="12">
            <Template>
                <DxTextBox Id="archive-password" @bind-Text="@(this.ViewModel.AuthenticationDto.Password)"
                           ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                           NullText="Enter the archive password"
                           Password="true"/>
            </Template>
        </DxFormLayoutItem>
    </DxFormLayout>

    <div class="font-size-small m-top-10px">
        Open an exported ECSS-E-TM-10-25 Annex C3 archive. The model opens read-only and the uploaded file is removed when you log out.
    </div>

    <ValidationSummary id="archive-login-validation"/>

    @if (this.ViewModel.AuthenticationResult is { IsFailed: true })
    {
        <ul id="archive-login-errors" class="validation-errors">
            @foreach (var error in this.ViewModel.AuthenticationResult.Errors)
            {
                <li class="validation-message">@error.Message</li>
            }
        </ul>
    }

    <div class="modal-footer">
        <DxButton Id="archive-connectbtn" Text="Open Archive" CssClass="btn btn-connect"
                  Enabled="@(!this.ViewModel.IsLoading)"
                  SubmitFormOnClick="true"/>
    </div>
</EditForm>
