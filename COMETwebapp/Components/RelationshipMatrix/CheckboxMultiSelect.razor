@typeparam T
@inherits DisposableComponent

<div class="checkbox-multiselect">
    <button type="button" id="@this.TriggerId" class="checkbox-multiselect-trigger" @onclick="@(() => this.isOpen = !this.isOpen)">
        <span class="checkbox-multiselect-text">@this.SummaryText</span>
        <span class="checkbox-multiselect-caret oi oi-caret-bottom"></span>
    </button>

    <DxDropDown @bind-IsOpen="@this.isOpen"
                PositionMode="DropDownPositionMode.Bottom"
                PositionTarget="@this.TriggerSelector"
                HeaderVisible="false"
                FooterVisible="false">
        <BodyTemplate>
            <div class="checkbox-multiselect-body">
                <label class="checkbox-multiselect-selectall">
                    <DxCheckBox Checked="@this.AreAllSelected" CheckedChanged="@((bool value) => this.OnSelectAllChanged(value))">(Select All)</DxCheckBox>
                </label>

                <DxListBox Data="@this.Data"
                           Values="@this.Values"
                           ValuesChanged="@((IEnumerable<T> values) => this.OnValuesChanged(values))"
                           TextFieldName="@this.TextFieldName"
                           SelectionMode="ListBoxSelectionMode.Multiple"
                           ShowCheckboxes="true"
                           CssClass="checkbox-multiselect-list"/>
            </div>
        </BodyTemplate>
    </DxDropDown>
</div>
