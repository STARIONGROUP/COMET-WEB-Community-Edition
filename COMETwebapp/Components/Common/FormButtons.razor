@inherits DisposableComponent

<div class="dxbl-grid-edit-form-buttons">
    @if (this.DeleteButtonVisible && !this.IsReadOnly)
    {
        <DxButton Id="deleteItemButton"
                  Click="@(() => this.OnDelete.InvokeAsync())"
                  RenderStyle="@(CometButtonStyle.Danger.ToButtonRenderStyle())">
            Delete
        </DxButton>
    }

    @if (!this.IsReadOnly)
    {
        <DxButton Id="saveItemButton"
                  SubmitFormOnClick="true"
                  RenderStyle="@(CometButtonStyle.Primary.ToButtonRenderStyle())"
                  Enabled="@(this.SaveButtonEnabled && !this.IsLoading)">
            @(this.IsLoading ? "Loading" : "Save")
        </DxButton>
    }

    <DxButton Id="cancelItemButton"
              Click="@(() => this.OnCancel.InvokeAsync())"
              RenderStyle="@(CometButtonStyle.Secondary.ToButtonRenderStyle())">
        @(this.IsReadOnly ? "Close" : "Cancel")
    </DxButton>
</div>

@if (this.IsReadOnly)
{
    <div id="form-read-only-notice" class="form-read-only-notice">This model was opened from an archive, so it can be inspected but not changed.</div>
}

<div class="validation-container mt-3">
    @if (this.ValidationMessages is null)
    {
        <ValidationSummary />
    }
    else
    {
        <ul class="validation-errors">
            @foreach (var err in this.ValidationMessages)
            {
                <li class="validation-message">@err</li>
            }
        </ul>
    }
</div>