@using CDP4Common.EngineeringModelData
@using COMETwebapp.Components.ModelEditor
@inherits DisposableComponent

<div id="panel-action-bar" class="mb-2 d-flex flex-wrap align-items-center justify-content-end" style="gap:8px;">
    @if (this.ViewModel.SelectedElementDefinition is not null)
    {
        <div style="flex:1 1 200px; min-width:0;">
            <SearchBar @bind-Text="@this.SearchTerm" Placeholder="Search parameters or owner…"/>
        </div>
        <DxButton Id="addParameter" Text="Parameter" IconCssClass="@IconName.Add.GetCssClass()" Click="@(this.ViewModel.OpenAddParameterPopup)"/>
        <DxButton Id="addParameterGroup" Text="Parameter Group" IconCssClass="@IconName.Add.GetCssClass()" Click="@this.ViewModel.OpenCreateParameterGroupPopup"/>
    }

    <DxButton Id="addElementDefinition" Text="Element Definition" IconCssClass="@IconName.Add.GetCssClass()" Click="@this.ViewModel.OpenCreateElementDefinitionCreationPopup"/>
</div>

<DetailsPanelEditor ViewModel="this.ViewModel.ElementDefinitionDetailsViewModel"
                    SearchTerm="@this.SearchTerm"
                    OnEditParameter="@(parameter => this.ViewModel.OpenEditParameterPopup(parameter))"
                    OnDeleteParameter="@(parameter => this.ViewModel.OpenDeleteParameterPopup(parameter))"
                    OnCreateSubscription="@(parameter => this.ViewModel.OpenCreateSubscriptionPopup(parameter))"
                    OnDeleteSubscription="@(subscription => this.ViewModel.OpenDeleteSubscriptionPopup(subscription))"
                    OnCreateOverride="@(args => this.ViewModel.OpenCreateOverridePopup(args.Parameter, args.HostUsage))"
                    OnDeleteOverride="@(parameterOverride => this.ViewModel.OpenDeleteOverridePopup(parameterOverride))"
                    OnEditElement="@this.ViewModel.OpenEditElementPopup"
                    OnEditDefinition="@this.ViewModel.OpenEditDefinitionPopup"
                    OnDeleteElement="@this.ViewModel.OpenDeleteElementPopup"
                    DisableDelete="@this.ViewModel.IsSelectedElementTopElement"
                    AvailableParameterGroups="@this.ViewModel.AvailableParameterGroups"
                    OnAssignParameterGroup="@(args => this.ViewModel.AssignParameterToGroupAsync(args))"
                    OnReassignGroupContaining="@(args => this.ViewModel.ReassignGroupContainingAsync(args))"
                    OnEditParameterGroup="@(g => this.ViewModel.OpenEditParameterGroupPopup(g))"
                    OnDeleteParameterGroup="@(g => this.ViewModel.OpenDeleteParameterGroupPopup(g))"/>

<DxPopup CloseOnOutsideClick="false" HeaderText="Create Element Definition" @bind-Visible="@this.ViewModel.IsOnCreationMode" Width="40vw">
    <BodyContentTemplate>
        <ElementDefinitionCreation ViewModel="@this.ViewModel.ElementDefinitionCreationViewModel"/>
    </BodyContentTemplate>
</DxPopup>

<DxPopup CloseOnOutsideClick="false" HeaderText="Add Parameter" @bind-Visible="@this.ViewModel.IsOnAddingParameterMode" Width="40vw">
    <BodyContentTemplate>
        <AddParameter ViewModel="@this.ViewModel.AddParameterViewModel"/>
    </BodyContentTemplate>
</DxPopup>

<DxPopup CloseOnOutsideClick="false" HeaderText="Edit Parameter" @bind-Visible="@this.ViewModel.IsOnEditParameterMode" Width="min(1150px, 90vw)">
    <BodyContentTemplate>
        <EditParameter ViewModel="@this.ViewModel.EditParameterViewModel"/>
    </BodyContentTemplate>
</DxPopup>

<DxPopup CloseOnOutsideClick="false" HeaderText="Edit Parameter Subscription" @bind-Visible="@this.ViewModel.IsOnEditSubscriptionMode" Width="min(1000px, 90vw)">
    <BodyContentTemplate>
        <EditParameterSubscription ViewModel="@this.ViewModel.EditParameterSubscriptionViewModel"/>
    </BodyContentTemplate>
</DxPopup>

<DxPopup CloseOnOutsideClick="false"
         HeaderText="Parameter Group"
         @bind-Visible="@this.ViewModel.IsOnParameterGroupEditMode"
         Width="30vw">
    <BodyContentTemplate>
        <div class="mb-3">
            <label class="form-label">Name</label>
            <DxTextBox @bind-Text="@this.ViewModel.ParameterGroupName" NullText="Group name…"/>
        </div>
        <div class="mb-3">
            <label class="form-label">Containing Group (optional)</label>
            <DxComboBox TData="ParameterGroup" TValue="ParameterGroup"
                        Data="@this.ViewModel.AvailableContainingGroups"
                        @bind-Value="@this.ViewModel.ParameterGroupContainingGroup"
                        TextFieldName="@nameof(ParameterGroup.Name)"
                        NullText="No containing group (top-level)"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"/>
        </div>
        <div class="d-flex justify-content-end" style="gap:8px;">
            <DxButton Text="Cancel"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      Click="@(() => this.ViewModel.IsOnParameterGroupEditMode = false)"/>
            <DxButton Text="Save"
                      RenderStyle="ButtonRenderStyle.Primary"
                      Click="@this.ViewModel.SaveParameterGroupAsync"/>
        </div>
    </BodyContentTemplate>
</DxPopup>

<ConfirmCancelPopup ViewModel="@this.ViewModel.DeleteElementPopupViewModel"/>

<ConfirmCancelPopup ViewModel="@this.ViewModel.DeleteParameterPopupViewModel"/>

<ConfirmCancelPopup ViewModel="@this.ViewModel.CreateSubscriptionPopupViewModel"/>

<ConfirmCancelPopup ViewModel="@this.ViewModel.DeleteSubscriptionPopupViewModel"/>

<ConfirmCancelPopup ViewModel="@this.ViewModel.CreateOverridePopupViewModel"/>

<ConfirmCancelPopup ViewModel="@this.ViewModel.DeleteOverridePopupViewModel"/>

<ConfirmCancelPopup ViewModel="@this.ViewModel.DeleteParameterGroupPopupViewModel"/>

<DxPopup CloseOnOutsideClick="false"
         HeaderText="@(this.ViewModel.IsEditingDefinition || this.ViewModel.SelectedElement is not ElementUsage ? "Edit Element Definition" : "Edit Element Usage")"
         @bind-Visible="@this.ViewModel.IsOnEditMode"
         Width="40vw">
    <BodyContentTemplate>
        @if (!this.ViewModel.IsEditingDefinition && this.ViewModel.SelectedElement is ElementUsage)
        {
            <EditElementUsage ViewModel="@this.ViewModel.EditElementUsageViewModel"/>
        }
        else
        {
            <EditElementDefinition ViewModel="@this.ViewModel.EditElementDefinitionViewModel"/>
        }
    </BodyContentTemplate>
</DxPopup>
