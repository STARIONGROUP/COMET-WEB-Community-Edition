@namespace COMETwebapp.Components.Common
@using CDP4Common.EngineeringModelData
@using COMETwebapp.ViewModels.Components.SystemRepresentation.Rows

@if (this.HasVisibleContent)
{
    <div class="group-card @(this.Group is null ? "ungrouped" : "") @(this.IsDropTarget ? "drop-target" : "")"
         @ondragover:preventDefault="true"
         @ondragenter="@(() => this.OnDragEnter())"
         @ondragleave="@(() => this.OnDragLeave())"
         @ondrop="@(async _ => await this.HandleDrop())">

        @if (this.Group is not null)
        {
            <div class="group-card-header group-card-header-draggable"
                 @onclick="this.ToggleCollapsed"
                 draggable="true"
                 @ondragstart:stopPropagation="true"
                 @ondragstart="@(() => this.OnGroupDragStart.InvokeAsync(this.Group))"
                 @ondragend="@(() => this.OnGroupDragEnd.InvokeAsync())">
                <span class="group-card-chevron @(this.IsExpanded ? "expanded" : "")">&#8250;</span>
                <span class="group-card-name">@this.Name</span>
                @if (this.OnEditGroup.HasDelegate)
                {
                    <span @onclick:stopPropagation="true">
                        <DxButton IconCssClass="@IconName.Edit.GetCssClass()"
                                  RenderStyleMode="ButtonRenderStyleMode.Text"
                                  SizeMode="SizeMode.Small"
                                  CssClass="ms-1"
                                  title="Edit this Parameter Group"
                                  Click="@(() => this.OnEditGroup.InvokeAsync(this.Group))"/>
                    </span>
                }
                @if (this.OnDeleteGroup.HasDelegate)
                {
                    <span @onclick:stopPropagation="true">
                        <DxButton IconCssClass="@IconName.Delete.GetCssClass()"
                                  RenderStyle="ButtonRenderStyle.Danger"
                                  RenderStyleMode="ButtonRenderStyleMode.Text"
                                  SizeMode="SizeMode.Small"
                                  CssClass="ms-1"
                                  title="Delete this Parameter Group"
                                  Click="@(() => this.OnDeleteGroup.InvokeAsync(this.Group))"/>
                    </span>
                }
            </div>
        }
        else
        {
            <div class="group-card-header" @onclick="this.ToggleCollapsed">
                <span class="group-card-chevron @(this.IsExpanded ? "expanded" : "")">&#8250;</span>
                <span class="group-card-name">@this.Name</span>
            </div>
        }

        @if (this.IsExpanded)
        {
            <div class="group-card-body">
                @foreach (var child in this.ChildGroups)
                {
                    <ParameterGroupSection Group="@child"
                                          AllRows="@this.AllRows"
                                          AllGroups="@this.AllGroups"
                                          SearchTerm="@this.SearchTerm"
                                          Level="@(this.Level + 1)"
                                          OnEditParameter="this.OnEditParameter"
                                          OnDeleteParameter="this.OnDeleteParameter"
                                          OnCreateSubscription="this.OnCreateSubscription"
                                          OnDeleteSubscription="this.OnDeleteSubscription"
                                          OnCreateOverride="this.OnCreateOverride"
                                          OnDeleteOverride="this.OnDeleteOverride"
                                          OnCardDragStart="this.OnCardDragStart"
                                          OnCardDragEnd="this.OnCardDragEnd"
                                          OnSectionDrop="this.OnSectionDrop"
                                          OnEditGroup="this.OnEditGroup"
                                          OnDeleteGroup="this.OnDeleteGroup"
                                          OnGroupDragStart="this.OnGroupDragStart"
                                          OnGroupDragEnd="this.OnGroupDragEnd"/>
                }
                <div class="param-cards">
                    @foreach (var row in this.DirectRows)
                    {
                        <ParameterCard Row="@row"
                                       OnEditParameter="this.OnEditParameter"
                                       OnDeleteParameter="this.OnDeleteParameter"
                                       OnCreateSubscription="this.OnCreateSubscription"
                                       OnDeleteSubscription="this.OnDeleteSubscription"
                                       OnCreateOverride="this.OnCreateOverride"
                                       OnDeleteOverride="this.OnDeleteOverride"
                                       OnCardDragStart="this.OnCardDragStart"
                                       OnCardDragEnd="this.OnCardDragEnd"/>
                    }
                </div>
            </div>
        }
    </div>
}
