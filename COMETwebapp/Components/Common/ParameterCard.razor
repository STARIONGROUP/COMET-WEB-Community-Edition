@namespace COMETwebapp.Components.Common

<div class="parameter-card"
     draggable="true"
     @ondragstart="@(() => this.OnCardDragStart.InvokeAsync(this.Row))"
     @ondragend="@(() => this.OnCardDragEnd.InvokeAsync(this.Row))">

    <div class="d-flex align-items-center" style="margin-bottom:2px;gap:6px;">
        <h6 title="@this.Row.ParameterTypeName"
            style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-bottom:0;">
            @this.Row.ParameterTypeName
            @if (this.Row.IsOptionDependent)
            {
                <CometIcon Icon="IconName.Settings" CssClass="option-dep-icon" Title="Option dependent parameter"/>
            }
        </h6>
        <div class="d-flex align-items-center flex-nowrap" style="flex-shrink:0;">
            <StarionPill ColorSeed="@($"owner:{this.Row.Owner}")" Title="@($"Owning Domain Of Expertise: {this.Row.Owner}")" Style="white-space:nowrap;flex-shrink:0;">
                @this.Row.Owner
            </StarionPill>
            @if (this.OnCreateSubscription.HasDelegate && this.Row.CanSubscribe)
            {
                <DxButton IconCssClass="@IconName.Bell.GetCssClass()"
                          RenderStyle="@(CometButtonStyle.Edit.ToButtonRenderStyle())"
                          RenderStyleMode="ButtonRenderStyleMode.Text"
                          CssClass="ms-1 flex-shrink-0"
                          Click="@(() => this.OnCreateSubscription.InvokeAsync(this.Row.Parameter))"
                          title="Subscribe to this Parameter as the current Domain of Expertise"/>
            }
            else if (this.OnDeleteSubscription.HasDelegate && this.Row.HasCurrentDomainSubscription)
            {
                <DxButton IconCssClass="@IconName.Bell.GetCssClass()"
                          RenderStyle="@(CometButtonStyle.Danger.ToButtonRenderStyle())"
                          RenderStyleMode="ButtonRenderStyleMode.Text"
                          CssClass="ms-1 flex-shrink-0"
                          Click="@(() => this.OnDeleteSubscription.InvokeAsync(this.Row.CurrentDomainSubscription))"
                          title="Remove this Domain's subscription to the Parameter (the Parameter itself is kept)"/>
            }
            @if (this.OnCreateOverride.HasDelegate && this.Row.CanCreateOverride)
            {
                <DxButton IconCssClass="@IconName.Branch.GetCssClass()"
                          RenderStyle="@(CometButtonStyle.Edit.ToButtonRenderStyle())"
                          RenderStyleMode="ButtonRenderStyleMode.Text"
                          CssClass="ms-1 flex-shrink-0"
                          Click="@(() => this.OnCreateOverride.InvokeAsync((this.Row.Parameter, this.Row.HostElementUsage)))"
                          title="Override this Parameter on the selected Element Usage"/>
            }
            else if (this.OnDeleteOverride.HasDelegate && this.Row.HasOverride)
            {
                <DxButton IconCssClass="@IconName.Branch.GetCssClass()"
                          RenderStyle="@(CometButtonStyle.Danger.ToButtonRenderStyle())"
                          RenderStyleMode="ButtonRenderStyleMode.Text"
                          CssClass="ms-1 flex-shrink-0"
                          Click="@(() => this.OnDeleteOverride.InvokeAsync(this.Row.CurrentOverride))"
                          title="Delete this override (the underlying Parameter is preserved)"/>
            }
            @if (this.Row.HasOtherDomainSubscriptions)
            {
                <span class="other-sub-bell ms-1 flex-shrink-0"
                      title="Subscribed by: @this.Row.OtherDomainSubscriptionOwners">
                    <CometIcon Icon="IconName.Bell"/>
                </span>
            }
            @if (this.OnEditParameter.HasDelegate)
            {
                <DxButton IconCssClass="@IconName.Edit.GetCssClass()"
                          RenderStyle="@(CometButtonStyle.Edit.ToButtonRenderStyle())"
                          RenderStyleMode="ButtonRenderStyleMode.Text"
                          CssClass="ms-1 flex-shrink-0"
                          Click="@(() => this.OnEditParameter.InvokeAsync(this.Row.HasOverride ? this.Row.CurrentOverride : (ParameterOrOverrideBase)this.Row.Parameter))"
                          title="Edit this parameter"/>
            }
            @if (this.OnDeleteParameter.HasDelegate)
            {
                <DxButton IconCssClass="@IconName.Delete.GetCssClass()"
                          RenderStyle="@(CometButtonStyle.Danger.ToButtonRenderStyle())"
                          RenderStyleMode="ButtonRenderStyleMode.Text"
                          CssClass="ms-1 flex-shrink-0"
                          Click="@(() => this.OnDeleteParameter.InvokeAsync(this.Row.Parameter))"
                          title="Delete this parameter"/>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-12"
             style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
             title="@this.Row.ModelCode">
            @this.Row.ModelCode
        </div>
    </div>

    @if (this.Row.IsStateDependent)
    {
        <div class="row" style="border-top:1px dotted darkgray;margin-top:8px;padding-top:8px;">
            <div class="col d-flex align-items-center" style="gap:6px;">
                <StarionPill Style="white-space:nowrap;">
                    @this.Row.StateValues.Count states
                </StarionPill>
                <button class="btn btn-sm btn-link p-0"
                        title="@(this.statesExpanded ? "Collapse state values" : "Expand state values")"
                        @onclick="this.ToggleStatesExpanded">
                    <CometIcon Icon="@(this.statesExpanded ? IconName.ChevronUp : IconName.ChevronDown)"/>
                </button>
            </div>
        </div>
        @if (this.statesExpanded)
        {
            <div class="state-values">
                @foreach (var stateRow in this.Row.StateValues)
                {
                    <div class="state-value-block">
                        <div class="state-value-name">@stateRow.StateName</div>
                        <div class="row" style="margin-top:4px;">
                            <div class="col-6">
                                <span>
                                    <StarionPill Title="@($"Value Switch: {stateRow.SwitchValue}")">
                                        @stateRow.SwitchValue
                                    </StarionPill>
                                </span>
                                <span>Actual:</span>
                            </div>
                            <div class="col-6">
                                Published:
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6"
                                 style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                                 title="Actual Value: @stateRow.ActualValue">
                                @stateRow.ActualValue
                            </div>
                            <div class="col-6"
                                 style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                                 title="Published Value: @stateRow.PublishedValue">
                                @stateRow.PublishedValue
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="row" style="border-top:1px dotted darkgray;margin-top:8px;padding-top:8px;">
            <div class="col-6">
                <span>
                    <StarionPill Title="@($"Actual Value's Value Switch: {this.Row.SwitchValue}")">
                        @this.Row.SwitchValue
                    </StarionPill>
                </span>
                <span>Actual:</span>
            </div>
            <div class="col-6">
                Published:
            </div>
        </div>

        <div class="row">
            <div class="col-6"
                 style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                 title="Actual Value: @this.Row.ActualValue">
                @this.Row.ActualValue
            </div>
            <div class="col-6"
                 style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                 title="Published Value: @this.Row.PublishedValue">
                @this.Row.PublishedValue
            </div>
        </div>
    }

</div>
