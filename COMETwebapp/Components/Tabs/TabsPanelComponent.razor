@using CDP4Common.CommonData
@using COMETwebapp.Components.Shared.PageIntroBox
@using COMETwebapp.Model
@inherits DisposableComponent

<div class="panel-view @(this.CssClass)">
    @if (this.Panel.CurrentTab is not null)
    {
        <div class="tabs-row align-items-center" role="group" aria-label="Open tabs" aria-keyshortcuts="Alt+Shift+2">
            <div class="tabs-container">
                <SortableList Group="tabs-panel"
                              Items="@(this.Panel.OpenTabs.Items.ToList())"
                              OnUpdate="@(indexes => this.SortTabs(indexes.oldIndex, indexes.newIndex))"
                              OnRemove="@(indexes => this.OnMovedTab(indexes.oldIndex, indexes.newIndex))"
                              Context="tab"
                              CssClass="d-flex gap-2 flex-shrink-0">
                    <SortableItemTemplate>
                        <TabComponent Text="@(GetTabText(tab))"
                                      Caption="@(this.GetCaptionText(tab.ObjectOfInterest))"
                                      Icon="IconName.Close"
                                      CustomOptionIcon="IconName.Copy"
                                      CustomOptionIconVisible="@(tab.ObjectOfInterest != null)"
                                      OnClick="@(() => this.OnTabClick.InvokeAsync((tab, this.Panel)))"
                                      OnIconClick="@(() => this.OnRemoveTabClick.InvokeAsync(tab))"
                                      OnCustomOptionIconClick="@(() => this.OnCreateTabForModel.InvokeAsync(tab))"
                                      IsCurrent="@(tab == this.Panel.CurrentTab)"
                                      ApplicationIcon="@(Applications.ExistingApplications.OfType<TabbedApplication>().First(x => x.ComponentType == tab.ComponentType).Icon)"
                                      @key="tab"/>
                    </SortableItemTemplate>
                </SortableList>

                <TabComponent Id="open-new-tab"
                              Text="Select Model"
                              Icon="IconName.Add"
                              OnClick="@(() => this.OnOpenTabClick.Invoke())"/>
            </div>
            <div class="d-flex align-items-center gap-2 ms-auto">
                @if (!this.IsPageIntroductionVisible)
                {
                    <DxButton Click="@(this.ReopenIntroAsync)"
                              RenderStyle="@(CometButtonStyle.Secondary.ToButtonRenderStyle())"
                              title="Show application introduction"
                              aria-label="@($"Show introduction for {this.CurrentApplication?.Name}")"
                              IconCssClass="@IconName.Info.GetCssClass()" />
                }

                @if (this.CurrentDomainOfExpertise != null)
                {
                    <DxButton Id="switch-domain-badge-button"
                              Click="@(() => this.ViewModel.AskToSwitchDomain(this.Panel))"
                              RenderStyle="@(CometButtonStyle.Secondary.ToButtonRenderStyle())"
                              Text="@(this.CurrentDomainOfExpertise.ShortName)"
                              title="Click to switch Domain of Expertise"
                              IconCssClass="@IconName.Transfer.GetCssClass()" />
                }

                <span title="@(this.GetSplitViewTooltip())" class="flex-shrink-0 pl-2 d-flex">
                    <DxButton Click="@(this.AddSidePanel)"
                              Enabled="@(this.IsSplitViewEnabled)"
                              RenderStyle="@(CometButtonStyle.None.ToButtonRenderStyle())"
                              Id="new-side-panel-button"
                              CssClass="p-0"
                              Visible="@(this.IsSplitViewVisible)"
                              aria-label="@(this.GetSplitViewTooltip())">
                        <CometIcon Icon="IconName.Columns"
                                   Size="30"/>
                    </DxButton>
                </span>
            </div>
        </div>
        <div class="template-container" id="tabs-page-content">
            <PageIntroBox @bind-IsPageIntroductionVisible="@this.IsPageIntroductionVisible" 
                          Application="@(this.CurrentApplication)" />

            <DynamicApplicationBase ViewModel="this.Panel.CurrentTab.ApplicationBaseViewModel"
                                    ApplicationBaseType="this.Panel.CurrentTab.ComponentType"
                                    CurrentThing="this.Panel.CurrentTab.ObjectOfInterest as Thing"
                                    Id="@(this.Panel.CurrentTab.Id)"/>
        </div>
    }
</div>