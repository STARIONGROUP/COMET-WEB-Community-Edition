@inherits DisposableComponent

<div id="propertiesPanel">

    @if (this.ViewModel.IsVisible)
    {
        <div id="properties-header">
            <h4 id="properties-title">@(this.Title)</h4>
            <div id="properties-header-actions">
                <DxButton Click="@this.OpenSubmitDialog"
                          Text="Submit"
                          RenderStyle="@(CometButtonStyle.Primary.ToButtonRenderStyle())"
                          Enabled="@(this.ViewModel.ParameterHaveChanges)"/>
                @this.HeaderActions
            </div>
        </div>

        <div id="parameters-section">
            @{
                var parameters = this.ViewModel.ParametersInUse ?? [];

                @foreach (var parameter in parameters)
                {
                    <p class="@this.GetParameterItemCssClass(parameter)" @onclick="() => this.ViewModel.SelectedParameter = parameter">
                        @parameter.ParameterType?.Name
                        @if (this.ViewModel.HasChanges(parameter))
                        {
                            <span class="parameter-item-revert"
                                  title="Revert to the original value"
                                  @onclick:stopPropagation="true"
                                  @onclick="@(() => this.RevertChange(parameter))">&#8635;</span>
                        }
                    </p>
                }
            }
        </div>
    }

    @{
        var detailsEditor = this.ViewModel.CreateDetailsComponentViewModel();
    }
    <DetailsComponent @key="detailsEditor" ViewModel="detailsEditor"/>
</div>

<DxPopup CloseOnOutsideClick="false"
         HeaderText="Confirm parameter changes"
         @bind-Visible="@this.ShowSubmitDialog"
         Closed="@this.OnSubmitDialogClosed"
         Width="min(480px, 90vw)">
    <div id="submit-dialog-body">
        <div class="submit-changes-scroll">
            <table class="submit-changes-table">
                <thead>
                    <tr>
                        <th>Parameter</th>
                        <th>Old value</th>
                        <th>New value</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var parameter in this.ViewModel.GetChangedParameters())
                    {
                        var dialogEditor = this.ViewModel.GetDialogEditor(parameter);

                        <tr>
                            <td>@this.ViewModel.GetParameterDisplayName(parameter)</td>
                            <td class="old-value">@this.ViewModel.GetOriginalValue(parameter)</td>
                            <td class="new-value">
                                <div class="new-value-cell">
                                    <DetailsComponent @key="dialogEditor" ViewModel="dialogEditor"/>
                                    <span class="dialog-revert"
                                          title="Discard this change and restore the original value"
                                          @onclick="@(() => this.RevertChangeInDialog(parameter))">&#8635;</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="submit-dialog-actions">
            <DxButton Text="Cancel"
                      RenderStyle="@(CometButtonStyle.Secondary.ToButtonRenderStyle())"
                      Click="@(() => this.ShowSubmitDialog = false)"/>
            <DxButton Text="OK"
                      RenderStyle="@(CometButtonStyle.Primary.ToButtonRenderStyle())"
                      Click="@this.ConfirmSubmit"/>
        </div>
    </div>
</DxPopup>
