@using CDP4Common.EngineeringModelData

@if (this.ViewModel.ElementUsage is not null)
{
    <EditForm Context="EditFormContext" Model="@this.ViewModel.ElementUsage" OnValidSubmit="@this.ViewModel.OnValidSubmit">
        <FluentValidationValidator />
        <DxFormLayout CssClass="w-100">
            <DxFormLayoutItem Caption="Shortname:" ColSpanMd="10">
                <DxTextBox @bind-Text="@this.ViewModel.ElementUsage.ShortName" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Name:" ColSpanMd="10">
                <DxTextBox @bind-Text="@this.ViewModel.ElementUsage.Name" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Owner:" ColSpanMd="10">
                <DomainOfExpertiseSelector ViewModel="@(this.ViewModel.DomainOfExpertiseSelectorViewModel)"
                                           DisplayText="@(string.Empty)"/>
            </DxFormLayoutItem>
            @if (this.ViewModel.AvailableOptions.Count > 1)
            {
                <DxFormLayoutItem Caption="Options:" ColSpanMd="10" CaptionPosition="CaptionPosition.Vertical">
                    <DxListBox Data="@this.ViewModel.AvailableOptions"
                               @bind-Values="@this.ViewModel.SelectedOptions"
                               SelectionMode="ListBoxSelectionMode.Multiple"
                               TextFieldName="@nameof(Option.Name)"
                               ShowCheckboxes="true"/>
                </DxFormLayoutItem>
            }
        </DxFormLayout>
        <ValidationSummary />
        @if (!this.IsReadOnly)
        {
            <div class="modal-footer m-top-10px">
                <DxButton RenderStyle="@(CometButtonStyle.Primary.ToButtonRenderStyle())" Text="Save" SubmitFormOnClick="true" />
            </div>
        }
    </EditForm>
}

@if (this.IsReadOnly)
{
    <div id="form-read-only-notice" class="form-read-only-notice">This model was opened from an archive, so it can be inspected but not changed.</div>
}
