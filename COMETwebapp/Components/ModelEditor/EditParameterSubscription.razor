@namespace COMETwebapp.Components.ModelEditor
@using COMETwebapp.ViewModels.Components.ModelEditor.EditParameterSubscriptionViewModel
@inherits DisposableComponent

@if (this.ViewModel.Subscription is not null)
{
    <div class="edit-parameter-tab">
        <div class="edit-parameter-fields">
            <DxFormLayout>
                <DxFormLayoutItem Caption="Subscribed Parameter:" ColSpanMd="12">
                    <DxTextBox Text="@this.ViewModel.SubscribedParameterName" ReadOnly="true"/>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Owner:" ColSpanMd="12">
                    <DxTextBox Text="@this.ViewModel.OwnerShortName" ReadOnly="true"/>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Model Code:" ColSpanMd="12">
                    <DxTextBox Text="@this.ViewModel.ModelCode" ReadOnly="true"/>
                </DxFormLayoutItem>
            </DxFormLayout>
        </div>

        <div class="edit-parameter-values-label">Subscription values:</div>
        <div class="edit-parameter-values-area">
            <DxGrid Data="@this.ViewModel.ValueRows" CssClass="default-grid edit-parameter-values" Width="100%" ShowAllRows="true" VerticalScrollBarMode="ScrollBarMode.Auto" HorizontalScrollBarMode="ScrollBarMode.Auto">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(EditParameterSubscriptionValueSetRowViewModel.OwnerShortName)" Caption="Owner" MinWidth="70"/>
                    @if (this.IsCompound)
                    {
                        <DxGridDataColumn FieldName="@nameof(EditParameterSubscriptionValueSetRowViewModel.Name)" Caption="Name" MinWidth="90"/>
                    }
                    @if (this.HasOptionColumn)
                    {
                        <DxGridDataColumn FieldName="@nameof(EditParameterSubscriptionValueSetRowViewModel.OptionName)" Caption="Option" MinWidth="70"/>
                    }
                    @if (this.HasStateColumn)
                    {
                        <DxGridDataColumn FieldName="@nameof(EditParameterSubscriptionValueSetRowViewModel.StateName)" Caption="State" MinWidth="60"/>
                    }
                    <DxGridDataColumn FieldName="@nameof(EditParameterSubscriptionValueSetRowViewModel.ActualValue)" Caption="Actual Value" MinWidth="80"/>
                    <DxGridDataColumn Caption="Switch" MinWidth="110">
                        <CellDisplayTemplate Context="cell">
                            @if (cell.DataItem is EditParameterSubscriptionValueSetRowViewModel row)
                            {
                                <ParameterSwitchKindSelector ViewModel="@row.ComponentRow.ParameterSwitchKindSelectorViewModel"/>
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(EditParameterSubscriptionValueSetRowViewModel.ComputedValue)" Caption="Computed" MinWidth="80"/>
                    <DxGridDataColumn Caption="Manual" MinWidth="130">
                        <CellDisplayTemplate Context="cell">
                            @if (cell.DataItem is EditParameterSubscriptionValueSetRowViewModel row)
                            {
                                <ParameterTypeEditorSelector ViewModel="@row.ComponentRow.ManualEditorViewModel"
                                                             BindValueMode="BindValueMode.OnLostFocus"/>
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="@nameof(EditParameterSubscriptionValueSetRowViewModel.ReferenceValue)" Caption="Reference" MinWidth="80"/>
                    @if (this.IsCompound)
                    {
                        <DxGridDataColumn FieldName="@nameof(EditParameterSubscriptionValueSetRowViewModel.ScaleShortName)" Caption="Scale" MinWidth="70"/>
                        <DxGridDataColumn FieldName="@nameof(EditParameterSubscriptionValueSetRowViewModel.ParameterTypeName)" Caption="Parameter Type" MinWidth="120"/>
                    }
                </Columns>
            </DxGrid>
        </div>
    </div>

    <div class="modal-footer m-top-10px">
        <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => this.ViewModel.CancelAsync())"/>
        <DxButton Text="OK" RenderStyle="ButtonRenderStyle.Primary" Click="@(() => this.ViewModel.SaveAsync())"/>
    </div>
}
