@using CDP4Common.EngineeringModelData
@using Microsoft.AspNetCore.Components.Forms
@inherits COMET.Web.Common.Components.DisposableComponent

<CascadingValue TValue="EditContext" Value="null" IsFixed="true">
    <DxGrid Data="@this.GetRows()" ShowAllRows="true" CssClass="cw-480">
        <Columns>
            <DxGridDataColumn Caption="Expression" MinWidth="240">
                <CellDisplayTemplate>
                    @GetSummary((ParametricConstraint)context.DataItem)
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridCommandColumn Width="90px">
                <HeaderTemplate>
                    <DxButton Id="addParametricConstraintButton" Text="Add" IconCssClass="oi oi-plus" Click="@(() => this.OpenAdd())" />
                </HeaderTemplate>
                <CellDisplayTemplate>
                    @{
                        var constraint = (ParametricConstraint)context.DataItem;
                    }
                    <DxButton IconCssClass="oi oi-pencil" Click="@(() => this.OpenEdit(constraint))" />
                    <DxButton Id="removeParametricConstraintButton" IconCssClass="oi oi-trash" Click="@(() => this.RemovalPopup.Request(constraint))" />
                </CellDisplayTemplate>
            </DxGridCommandColumn>
        </Columns>
    </DxGrid>

    <DxPopup CloseOnOutsideClick="false"
             ShowCloseButton="true"
             HeaderText="@(this.EditingConstraint != null && this.Requirement.ParametricConstraint.Contains(this.EditingConstraint) ? "Edit Parametric Constraint" : "Add Parametric Constraint")"
             Visible="@this.IsEditorOpen"
             VisibleChanged="@((bool visible) => this.OnEditorVisibleChanged(visible))"
             Width="min(760px, 94vw)">
        <BodyContentTemplate Context="editorPopupContext">
            @if (this.EditingConstraint != null)
            {
                <EditParametricConstraint @key="this.EditingConstraint.Iid"
                                          Constraint="@this.EditingConstraint"
                                          AvailableParameterTypes="@this.AvailableParameterTypes"
                                          OnSaved="@(() => this.HandleSaved())"
                                          OnCancelled="@(() => this.HandleCancelled())" />
            }
        </BodyContentTemplate>
    </DxPopup>

    <ConfirmRemovalPopup TItem="ParametricConstraint"
                         @ref="this.RemovalPopup"
                         HeaderText="Delete parametric constraint"
                         ContentText="Are you sure you want to delete this parametric constraint?"
                         OnRemove="@(constraint => this.Remove(constraint))" />
</CascadingValue>
