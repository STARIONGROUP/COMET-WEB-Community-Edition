@using COMETwebapp.ViewModels.Components.RequirementsEditor.Annotations

@{
    var summary = this.ViewModel.AnnotationsViewModel.GetSummary(this.Requirement);
}

<span class="req-annotation-badges">
    @if (summary.Count == 0)
    {
        @if (this.ViewModel.AnnotationsViewModel.CreatableKinds.Count > 0)
        {
            <button type="button"
                    class="req-annotation-add"
                    title="Add a note, change request, review item or request for deviation / waiver"
                    aria-label="@($"Annotate {this.Requirement.ShortName}")"
                    @onclick="@(() => this.Open(null))">
                <CometIcon Icon="IconName.MessageSquare" />
            </button>
        }
    }
    else
    {
        @foreach (var entry in summary)
        {
            <button type="button"
                    class="req-annotation-badge ann-kind-@RequirementAnnotationHelper.GetCssSuffix(entry.Kind) @(entry.OpenCount > 0 ? "has-open" : "is-resolved")"
                    title="@RequirementAnnotationHelper.GetSummaryTooltip(entry)"
                    aria-label="@RequirementAnnotationHelper.GetSummaryTooltip(entry)"
                    @onclick="@(() => this.Open(entry.Kind))">
                @if (entry.Kind == RequirementAnnotationKind.Note)
                {
                    <CometIcon Icon="IconName.MessageSquare" />
                }
                else
                {
                    <span class="req-annotation-badge-label">@RequirementAnnotationHelper.GetAcronym(entry.Kind)</span>
                }
                <span class="req-annotation-badge-count">@entry.Count</span>
            </button>
        }
    }
</span>
