@using CDP4Common.SiteDirectoryData
@using COMETwebapp.ViewModels.Components.RequirementsEditor.ParametricConstraints

<div class="pc-editor">
    @if (this.viewModel.RootExpression == null)
    {
        <div class="pc-empty">
            <p>No expression defined. Click the button below to add your first expression.</p>
            <DxButton RenderStyle="@(CometButtonStyle.Primary.ToButtonRenderStyle())" IconCssClass="@IconName.Add.GetCssClass()" Text="Add First Expression" Enabled="@(!this.IsReadOnly)" Click="@(() => this.AddFirstExpression())" />
        </div>
    }
    else
    {
        <BooleanExpressionNode Row="@this.viewModel.RootExpression"
                               ViewModel="@this.viewModel"
                               IsRoot="true"
                               OnAddRelational="@((CompositeExpressionRow parent) => this.HandleAddRelational(parent))"
                               OnAddGroup="@((CompositeExpressionRow parent) => this.HandleAddGroup(parent))"
                               OnEditRelational="@((RelationalExpressionRow row) => this.HandleEditRelational(row))"
                               OnRemove="@((BooleanExpressionRow row) => this.viewModel.Remove(row))"
                               OnMoveUp="@((BooleanExpressionRow row) => this.viewModel.MoveUp(row))"
                               OnMoveDown="@((BooleanExpressionRow row) => this.viewModel.MoveDown(row))"
                               OnToggleNot="@((BooleanExpressionRow row) => EditParametricConstraintViewModel.ToggleNot(row))"
                               OnSetOperator="@(((CompositeExpressionRow Group, LogicalOperatorKind Operator) args) => EditParametricConstraintViewModel.SetOperator(args.Group, args.Operator))" />

        @if (this.viewModel.RootExpression is RelationalExpressionRow)
        {
            <div class="pc-root-add">
                <span class="pc-add pc-split">
                    <button type="button" class="pc-split-main" title="Add a relational expression"
                            @onclick="@(() => this.RootAddExpression())"><CometIcon Icon="IconName.Add"/> Add Expression</button>
                    <button type="button" class="pc-split-arrow" id="@this.uniqueRootAddId" title="More…"
                            @onclick="@(() => this.rootAddMenuOpen = !this.rootAddMenuOpen)">▾</button>
                </span>
                <DxDropDown @bind-IsOpen="@this.rootAddMenuOpen"
                            PositionMode="DropDownPositionMode.Bottom"
                            PositionTarget="@this.RootAddSelector"
                            CloseMode="DropDownCloseMode.Close"
                            HeaderVisible="false"
                            FooterVisible="false">
                    <BodyTemplate>
                        <div style="display:flex; flex-direction:column; min-width:170px;">
                            <DxButton RenderStyle="@(CometButtonStyle.Light.ToButtonRenderStyle())" IconCssClass="@IconName.Add.GetCssClass()" Text="Add Expression" Enabled="@(!this.IsReadOnly)" Click="@(() => this.RootAddExpression())" />
                            <DxButton RenderStyle="@(CometButtonStyle.Light.ToButtonRenderStyle())" IconCssClass="@IconName.Branch.GetCssClass()" Text="Add Group" Enabled="@(!this.IsReadOnly)" Click="@(() => this.RootAddGroup())" />
                        </div>
                    </BodyTemplate>
                </DxDropDown>
            </div>
        }
    }
</div>

<div class="modal-footer m-top-10px">
    <DxButton RenderStyle="@(CometButtonStyle.Secondary.ToButtonRenderStyle())" Text="@(this.IsReadOnly ? "Close" : "Cancel")" Click="@(() => this.OnCancelled.InvokeAsync())" />

    @if (!this.IsReadOnly)
    {
        <DxButton RenderStyle="@(CometButtonStyle.Primary.ToButtonRenderStyle())" Text="Save" Click="@(() => this.SaveAsync())" Enabled="@(this.viewModel.CanSave)" />
    }
</div>

<DxPopup CloseOnOutsideClick="false"
         ShowCloseButton="true"
         HeaderText="Edit Expression"
         Visible="@this.IsRelationalDialogOpen"
         VisibleChanged="@((bool visible) => this.OnRelationalDialogVisibleChanged(visible))"
         Width="min(460px, 92vw)">
    <BodyContentTemplate Context="relationalPopupContext">
        <DxFormLayout CssClass="w-100">
            <DxFormLayoutItem Caption="Parameter Type:" ColSpanMd="12">
                <DxComboBox Data="@this.AvailableParameterTypes"
                            Value="@this.relationalParameterType"
                            ValueChanged="@((ParameterType parameterType) => this.OnRelationalParameterTypeChanged(parameterType))"
                            TextFieldName="@nameof(ParameterType.Name)"
                            AllowUserInput="true"
                            FilteringMode="DataGridFilteringMode.Contains"
                            NullText="Select a Parameter Type" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Operator:" ColSpanMd="12">
                <DxComboBox Data="@OperatorOptions"
                            @bind-Value="@this.relationalOperator"
                            ValueFieldName="@nameof(OperatorOption.Kind)"
                            TextFieldName="@nameof(OperatorOption.Symbol)" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Value:" ColSpanMd="12">
                <DxTextBox @bind-Text="@this.relationalValue" NullText="Enter a value..." />
            </DxFormLayoutItem>
            @if (this.relationalParameterType is QuantityKind && this.AvailableRelationalScales.Any())
            {
                <DxFormLayoutItem Caption="Scale:" ColSpanMd="12">
                    <DxComboBox Data="@this.AvailableRelationalScales"
                                @bind-Value="@this.relationalScale"
                                TextFieldName="@nameof(MeasurementScale.ShortName)"
                                AllowUserInput="true"
                                FilteringMode="DataGridFilteringMode.Contains"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                NullText="Select a scale (optional)" />
                </DxFormLayoutItem>
            }
        </DxFormLayout>

        <div class="modal-footer m-top-10px">
            <DxButton RenderStyle="@(CometButtonStyle.Secondary.ToButtonRenderStyle())" Text="@(this.IsReadOnly ? "Close" : "Cancel")" Click="@(() => this.CancelRelational())" />

            @if (!this.IsReadOnly)
            {
                <DxButton RenderStyle="@(CometButtonStyle.Primary.ToButtonRenderStyle())" Text="Save" Click="@(() => this.ConfirmRelational())" Enabled="@(this.CanConfirmRelational)" />
            }
        </div>
    </BodyContentTemplate>
</DxPopup>
