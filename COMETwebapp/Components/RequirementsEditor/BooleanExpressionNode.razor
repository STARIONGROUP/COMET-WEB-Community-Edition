@using COMETwebapp.ViewModels.Components.RequirementsEditor.ParametricConstraints

@if (this.Row is RelationalExpressionRow relational)
{
    <div class="pc-node pc-leaf @(this.Row.IsValid ? string.Empty : "pc-invalid")">
        <button type="button" class="pc-toggle pc-not @(this.Row.IsNegated ? "pc-toggle-on" : string.Empty)" title="Negate (NOT)"
                @onclick="@(() => this.OnToggleNot.InvokeAsync(this.Row))">NOT</button>
        <span class="pc-summary">@this.ViewModel.GetSummary(this.Row)</span>
        <span class="pc-actions">
            @if (!this.IsRoot && this.CanMoveUp)
            {
                <button type="button" title="Move up" @onclick="@(() => this.OnMoveUp.InvokeAsync(this.Row))">&#8593;</button>
            }
            @if (!this.IsRoot && this.CanMoveDown)
            {
                <button type="button" title="Move down" @onclick="@(() => this.OnMoveDown.InvokeAsync(this.Row))">&#8595;</button>
            }
            <button type="button" title="Edit expression" @onclick="@(() => this.OnEditRelational.InvokeAsync(relational))"><CometIcon Icon="IconName.Edit"/></button>
            <button type="button" title="Delete" @onclick="@(() => this.OnRemove.InvokeAsync(this.Row))"><CometIcon Icon="IconName.Delete"/></button>
        </span>
    </div>
}
else if (this.Row is CompositeExpressionRow group)
{
    <div class="pc-node pc-group">
        <div class="pc-group-header @(group.IsValid ? string.Empty : "pc-invalid")">
            <span class="pc-toggle-group pc-ops">
                @foreach (var operatorKind in Operators)
                {
                    <button type="button" class="pc-toggle @(group.Operator == operatorKind ? "pc-toggle-on" : string.Empty)"
                            @onclick="@(() => this.OnSetOperator.InvokeAsync((group, operatorKind)))">@operatorKind.ToString().ToUpperInvariant()</button>
                }
            </span>
            <button type="button" class="pc-toggle pc-not @(this.Row.IsNegated ? "pc-toggle-on" : string.Empty)" title="Negate (NOT)"
                    @onclick="@(() => this.OnToggleNot.InvokeAsync(this.Row))">NOT</button>
            <span class="pc-summary">@this.ViewModel.GetSummary(this.Row)</span>
            <span class="pc-actions">
                @if (!this.IsRoot)
                {
                    <button type="button" title="Delete group" @onclick="@(() => this.OnRemove.InvokeAsync(this.Row))"><CometIcon Icon="IconName.Delete"/></button>
                }
            </span>
        </div>

        @if (group.Terms.Count < 2)
        {
            <div class="pc-warn">A group requires at least two expressions.</div>
        }

        <div class="pc-children">
            @foreach (var child in group.Terms)
            {
                <BooleanExpressionNode @key="child.Id"
                                       Row="@child"
                                       ViewModel="@this.ViewModel"
                                       IsRoot="false"
                                       OnAddRelational="@this.OnAddRelational"
                                       OnAddGroup="@this.OnAddGroup"
                                       OnEditRelational="@this.OnEditRelational"
                                       OnRemove="@this.OnRemove"
                                       OnMoveUp="@this.OnMoveUp"
                                       OnMoveDown="@this.OnMoveDown"
                                       OnToggleNot="@this.OnToggleNot"
                                       OnSetOperator="@this.OnSetOperator" />
            }

            <span class="pc-add pc-split">
                <button type="button" class="pc-split-main" title="Add a relational expression"
                        @onclick="@(() => this.AddExpressionClicked(group))"><CometIcon Icon="IconName.Add"/> Add Expression</button>
                <button type="button" class="pc-split-arrow" id="@this.AddButtonId" title="More…"
                        @onclick="@(() => this.addMenuOpen = !this.addMenuOpen)">▾</button>
            </span>
            <DxDropDown @bind-IsOpen="@this.addMenuOpen"
                        PositionMode="DropDownPositionMode.Bottom"
                        PositionTarget="@this.AddButtonSelector"
                        CloseMode="DropDownCloseMode.Close"
                        HeaderVisible="false"
                        FooterVisible="false">
                <BodyTemplate>
                    <div style="display:flex; flex-direction:column; min-width:170px;">
                        <DxButton RenderStyle="@(CometButtonStyle.Light.ToButtonRenderStyle())" IconCssClass="@IconName.Add.GetCssClass()" Text="Add Expression" Click="@(() => this.AddExpressionClicked(group))" />
                        <DxButton RenderStyle="@(CometButtonStyle.Light.ToButtonRenderStyle())" IconCssClass="@IconName.Branch.GetCssClass()" Text="Add Group" Click="@(() => this.AddGroupClicked(group))" />
                    </div>
                </BodyTemplate>
            </DxDropDown>
        </div>
    </div>
}
