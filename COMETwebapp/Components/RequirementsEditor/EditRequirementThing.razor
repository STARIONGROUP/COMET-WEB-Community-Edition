@using CDP4Common.EngineeringModelData
@using CDP4Common.SiteDirectoryData
@using COMET.Web.Common.Components
@using COMET.Web.Common.Components.Selectors
@using COMETwebapp.Components.Common

@if (this.ViewModel.Thing is not null)
{
    <EditForm Context="EditFormContext" Model="@this.ViewModel.Thing" OnValidSubmit="@this.ViewModel.OnValidSubmit">
        <FluentValidationValidator />
        <DxFormLayout CssClass="w-100">
            <DxFormLayoutTabPages>
                <DxFormLayoutTabPage Caption="Basic">
                    <DxFormLayoutItem Caption="Shortname:" ColSpanMd="10">
                        <DxTextBox @bind-Text="@this.ViewModel.DefinedThing.ShortName" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Name:" ColSpanMd="10">
                        <DxTextBox @bind-Text="@this.ViewModel.DefinedThing.Name" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Owner:" ColSpanMd="10">
                        <DomainOfExpertiseSelector ViewModel="@(this.ViewModel.DomainOfExpertiseSelectorViewModel)"
                                                   DisplayText="@(string.Empty)" />
                    </DxFormLayoutItem>
                    @if (this.ViewModel.ShowGroupSelector)
                    {
                        <DxFormLayoutItem Caption="Group:" ColSpanMd="10">
                            <DxComboBox Data="@this.ViewModel.AvailableGroups"
                                        @bind-Value="@this.ViewModel.SelectedGroup"
                                        TextFieldName="@nameof(RequirementsGroup.ShortName)"
                                        NullText="No group"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </DxFormLayoutItem>
                    }
                    <DxFormLayoutItem Caption="Definition language:" ColSpanMd="4">
                        <DxComboBox Data="@this.ViewModel.AvailableLanguages"
                                    @bind-Value="@this.ViewModel.PrimaryDefinitionLanguageCode"
                                    ValueFieldName="@nameof(NaturalLanguage.LanguageCode)"
                                    TextFieldName="@nameof(NaturalLanguage.NativeName)"
                                    AllowUserInput="true"
                                    FilteringMode="DataGridFilteringMode.Contains"
                                    NullText="Select a language..." />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Definition:" ColSpanMd="10" CaptionPosition="CaptionPosition.Vertical">
                        <DxMemo @bind-Text="@this.ViewModel.PrimaryDefinitionContent" Rows="4" NullText="Enter a definition..." />
                    </DxFormLayoutItem>
                    @if (this.ViewModel.IsDeprecatable)
                    {
                        <DxFormLayoutItem Caption="Deprecated:" ColSpanMd="6">
                            <DxCheckBox @bind-Checked="@this.ViewModel.IsDeprecated" />
                        </DxFormLayoutItem>
                    }
                </DxFormLayoutTabPage>

                <DxFormLayoutTabPage Caption="Category">
                    <CategoriesTable Thing="@this.ViewModel.CategorizableThing"
                                     AvailableCategories="@this.ViewModel.AvailableCategories" />
                </DxFormLayoutTabPage>

                <DxFormLayoutTabPage Caption="Definition">
                    <DefinitionsTable Thing="@this.ViewModel.DefinedThing"
                                      AvailableLanguages="@this.ViewModel.AvailableLanguages" />
                </DxFormLayoutTabPage>

                @if (this.ViewModel.IsRequirement)
                {
                    <DxFormLayoutTabPage Caption="Simple Parameter Values">
                        <SimpleParameterValuesTable Requirement="@this.ViewModel.RequirementThing"
                                                    AvailableParameterTypes="@this.ViewModel.AvailableParameterTypes" />
                    </DxFormLayoutTabPage>

                    <DxFormLayoutTabPage Caption="Parametric Constraints">
                        <ParametricConstraintsTable Requirement="@this.ViewModel.RequirementThing"
                                                    AvailableParameterTypes="@this.ViewModel.AvailableParameterTypes" />
                    </DxFormLayoutTabPage>
                }
            </DxFormLayoutTabPages>
        </DxFormLayout>
        <ValidationSummary />
        <div class="modal-footer m-top-10px">
            <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Save" SubmitFormOnClick="true" />
        </div>
    </EditForm>
}
