@inherits COMETwebapp.Components.Common.SelectedDataItemBase<CDP4Common.SiteDirectoryData.Participant, ParticipantRowViewModel>

<LoadingComponent IsVisible="@(this.ViewModel.IsLoading)">
    <DxGrid Data="this.ViewModel.Rows.Items"
            ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
            ShowSearchBox="true"
            ShowAllRows="true"
            SearchBoxNullText="Search for a participant...">
        <Columns>
            <DxGridDataColumn FieldName="@nameof(ParticipantRowViewModel.Name)" MinWidth="150" />
            <DxGridDataColumn FieldName="@nameof(ParticipantRowViewModel.Organization)" MinWidth="80" SearchEnabled="false" />
            <DxGridDataColumn FieldName="@nameof(ParticipantRowViewModel.Role)" MinWidth="80" SearchEnabled="false" />
            <DxGridDataColumn FieldName="@nameof(ParticipantRowViewModel.AssignedDomains)" MinWidth="100" SearchEnabled="false">
                <CellDisplayTemplate Context="assignedDomainsContext">
                    @{
                        var row = (ParticipantRowViewModel)assignedDomainsContext.DataItem;

                        <a @onclick="() => this.OpenAssignedDomainDetailsPopup(row)"
                           style="max-width: fit-content; white-space: nowrap;">
                          @assignedDomainsContext.DisplayText
                        </a>
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridCommandColumn Width="100px">
                <HeaderTemplate>
                    <DxButton Id="addParticipantButton" Text="Add" IconCssClass="@IconName.Add.GetCssClass()" Click="this.StartCreate" Enabled="@(!this.IsReadOnly && this.ViewModel.IsAllowedToCreate)" RenderStyle="@(CometButtonStyle.Primary.ToButtonRenderStyle())" />
                </HeaderTemplate>
                <CellDisplayTemplate>
                    @{
                        var row = (ParticipantRowViewModel)context.DataItem;

                        <DxButton Id="editParticipantButton"
                                  IconCssClass="@IconName.Edit.GetCssClass()"
                                  Click="@(() => this.StartEdit(row))"
                                  Enabled="@(row.IsAllowedToWrite)"
                                  RenderStyle="@(CometButtonStyle.Edit.ToButtonRenderStyle())"/>

                        <DxButton Id="deleteParticipantButton"
                                  IconCssClass="@IconName.Delete.GetCssClass()"
                                  Click="@(() => this.ViewModel.OnDeleteButtonClick(row))"
                                  Enabled="@(row.IsAllowedToWrite)"
                                  RenderStyle="@(CometButtonStyle.Danger.ToButtonRenderStyle())"/>
                    }
                </CellDisplayTemplate>
            </DxGridCommandColumn>
        </Columns>
    </DxGrid>
</LoadingComponent>

<DxPopup HeaderText="Participant"
         @bind-Visible="@this.IsOnEditMode"
         CssClass="pw-800"
         CloseOnOutsideClick="false">
    <BodyContentTemplate Context="popupContext">
        <ParticipantsForm ViewModel="@this.ViewModel"
                          ShouldCreate="@this.ShouldCreateThing"
                          IsVisible="@this.IsOnEditMode"
                          IsVisibleChanged="@(visible => this.IsOnEditMode = visible)"
                          OnSaved="@this.OnSaved"
                          OnCanceled="@(() => this.IsOnEditMode = false)" />
    </BodyContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="@this.ViewModel.IsOnDeletionMode" HeaderText="Please confirm" Width="auto" CloseOnOutsideClick="false">
    @this.ViewModel.PopupDialog
    <div class="dxbl-grid-confirm-dialog-buttons">
        <DxButton Text="Cancel " RenderStyle="@(CometButtonStyle.Secondary.ToButtonRenderStyle())" Click="@this.ViewModel.OnCancelPopupButtonClick" />
        <DxButton Text="Confirm" RenderStyle="@(CometButtonStyle.Danger.ToButtonRenderStyle())" Click="@this.ViewModel.OnConfirmPopupButtonClick" />
    </div>
</DxPopup>

<DxPopup @bind-Visible="@this.IsAssignedDomainsPopupVisible"
         HeaderText="Assigned Domains">
    <ul>
        @foreach (var assignedDomain in this.AssignedDomainsPopupList)
        {
            <li>@assignedDomain</li>
        }
    </ul>
</DxPopup>