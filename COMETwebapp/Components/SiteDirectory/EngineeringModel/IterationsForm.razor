@inherits SelectedDataItemForm

<EditForm Context="editFormContext" Model="@(this.ViewModel.CurrentThing)" OnValidSubmit="@(this.OnValidSubmit)">
    <FluentValidationValidator />
    <DxFormLayout CssClass="w-100">
        <DxFormLayoutItem Caption="Source Iteration:" ColSpanMd="10">
            <DxComboBox Data="@(this.ViewModel.SourceIterations)"
                        TextFieldName="@nameof(IterationSetup.IterationNumber)"
                        @bind-Value="@(this.ViewModel.CurrentThing.SourceIterationSetup)"
                        Enabled="@(this.ShouldCreate)"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                        CssClass="cw-480"/>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="Description:" ColSpanMd="10">
            <DxTextBox @bind-Text="@(this.ViewModel.CurrentThing.Description)"
                       CssClass="cw-480"/>
        </DxFormLayoutItem>
    </DxFormLayout>
    <div class="pt-3"></div>
    <FormButtons SaveButtonEnabled="@(this.IsSaveButtonEnabled(editFormContext))"
                 OnCancel="@(this.OnCancel)"
                 ValidationMessages="@(this.MapOfValidationMessages.SelectMany(x => x.Value))"/>
</EditForm>
