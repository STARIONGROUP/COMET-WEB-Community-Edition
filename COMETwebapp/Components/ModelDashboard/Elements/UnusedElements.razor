@using CDP4Common.EngineeringModelData
@using COMETwebapp.Utilities
@inherits HaveElementDefinitionData

@if(this.Elements != null && this.UnusedElementDefinitions != null)
{
    <div data-testid="dashboard-chart">
        <div class="row align-items-center justify-content-center">
            <div class="col-auto p-0">
                <h3 class="m-0">Unused Elements</h3>
            </div>
            <div class="col-auto p-0">
                <Tooltip MarginBottom="bottom-25" Text="Elements not used in an option">
                    <button type="button" class="btn-tooltip"><CometIcon Icon="IconName.Info" Size="16"/></button>
                </Tooltip>
            </div>
        </div>
        <div class="row">
            <DxChart Data="@this.Elements">
                <DxChartStackedBarSeries Color="HaveChartData.UsedChartColor" Name="@WebAppConstantValues.UsedElements" Filter="@((ElementDefinition e) => this.UnusedElementDefinitions.All(x => x.Iid != e.Iid))"
                                            ArgumentField="@(e => e.Owner.ShortName)" ValueField="@(e => 1)"
                                            AggregationMethod="Enumerable.Sum">
                    <DxChartSeriesLabel Position="RelativePosition.Inside" ShowForZeroValues="false"/>
                </DxChartStackedBarSeries>
                <DxChartStackedBarSeries Color="HaveChartData.UnusedChartColor" Name="@WebAppConstantValues.UnusedElements" Filter="@((ElementDefinition e) =>  this.UnusedElementDefinitions.Any(x => x.Iid == e.Iid))"
                                                    ArgumentField="@(e => e.Owner.ShortName)" ValueField="@(e => 1)"
                                                    AggregationMethod="Enumerable.Sum">
                    <DxChartSeriesLabel Position="RelativePosition.Inside" ShowForZeroValues="false"/>
                </DxChartStackedBarSeries>
                <DxChartTooltip Enabled="true" Position="RelativePosition.Inside">
                            <div class="small-margin">
                                <button class="card-btn" @onclick="@(() => this.AccessData(context.Point))">
                                    More
                                </button>
                            </div>
                </DxChartTooltip>
                <DxChartLegend Visible="true" Position="RelativePosition.Outside" VerticalAlignment="VerticalEdge.Bottom"/>
            </DxChart>
        </div>
	        <ElementDomainProgress ElementDefinitions="@this.FilterOnDomain(this.Elements)"
	                               IdentifiedElements="@this.FilterOnDomain(this.UnusedElementDefinitions)"
	                               GoodStrokeColor="@(HaveChartData.UsedColor)" WarningStrokeColor="@(HaveChartData.UnusedColor)"/>
    </div>   
}