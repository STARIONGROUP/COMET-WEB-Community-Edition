@using CDP4Common.EngineeringModelData
@using COMETwebapp.Utilities
@inherits HaveElementDefinitionData

@if (this.Elements != null && this.UnreferencedElementDefinitions != null)
{
    <div data-testid="dashboard-chart">
        <div class="row align-items-center justify-content-center">
            <div class="col-auto p-0">
                <h3 class="m-0">Unreferenced Elements</h3>
            </div>
            <div class="col-auto p-0">
                <Tooltip MarginBottom="bottom-60" Text="Elements without associated element usage">
                    <button type="button" class="btn-tooltip"><CometIcon Icon="IconName.Info" Size="16"/></button>
                </Tooltip>
            </div>
        </div>

            <DxChart Data="@this.Elements">
                <DxChartStackedBarSeries Color="HaveChartData.ReferencedChartColor" Name="@WebAppConstantValues.ReferencedElements" Filter="@((ElementDefinition e) => this.UnreferencedElementDefinitions.All(x => x.Iid != e.Iid))"
                                    ArgumentField="@(e => e.Owner.ShortName)" ValueField="@(e => 1)"
                                    AggregationMethod="Enumerable.Sum">
                <DxChartSeriesLabel Position="RelativePosition.Inside" ShowForZeroValues="false"/>
                </DxChartStackedBarSeries>
            <DxChartStackedBarSeries Color="HaveChartData.UnreferencedChartColor" Name="@WebAppConstantValues.UnreferencedElements" Filter="@((ElementDefinition e) => this.UnreferencedElementDefinitions.Any(x => x.Iid == e.Iid))"
                                                ArgumentField="@(e => e.Owner.ShortName)" ValueField="@(e => 1)"
                                                AggregationMethod="Enumerable.Sum">
                    <DxChartSeriesLabel Position="RelativePosition.Inside" ShowForZeroValues="false"/>
                </DxChartStackedBarSeries>
            <DxChartTooltip Enabled="true" Position="RelativePosition.Inside">
                    <div class="small-margin">
                        <button class="card-btn" @onclick="@(() => this.AccessData(context.Point))">
                            More
                        </button>
                    </div>
                </DxChartTooltip>
                <DxChartLegend Visible="true" Position="RelativePosition.Outside" VerticalAlignment="VerticalEdge.Bottom" />
            </DxChart>

        <ElementDomainProgress ElementDefinitions="this.FilterOnDomain(this.Elements)" IdentifiedElements="this.FilterOnDomain(this.UnreferencedElementDefinitions)"
                               GoodStrokeColor="@(HaveChartData.ReferencedColor)" WarningStrokeColor="@(HaveChartData.UnreferencedColor)" />
    </div>
}

