@using CDP4Common.EngineeringModelData
@using COMETwebapp.Utilities
@inherits HaveValueSetsChartData

<div class="width-100" data-testid="dashboard-chart">
	<div class="row align-items-center justify-content-center">
		<div class="col-auto p-0">
			<h3 class="m-0">Missing Values</h3>
		</div>
		<div class="col-auto p-0">
			<Tooltip MarginBottom="bottom-60" Text="Missing Values = Published Values with Default Value '-'">
				<button type="button" class="btn-tooltip">
					<CometIcon Icon="IconName.Info" Size="16"/>
				</button>
			</Tooltip>
		</div>
	</div>
	@if (this.ValueSets.Any())
	{
		<DxChart Data="@(this.ValueSets)" CssClass="justify-content-center">
			<DxChartTooltip Enabled="true" Position="RelativePosition.Inside">
				@{
					var total = this.ValueSets.Count(d => d.Owner.ShortName.Equals(context.Point.Argument));
					var count = this.CountValueSetPerDomain(context.Point.SeriesName, context.Point.Argument);
					var number = Math.Round((double)count / total * 100);
				}
				<div class="small-margin">
					<div class="fw-bold">@(this.GetDomainName(context.Point.Argument))</div>
					@if (!double.IsNaN(number))
					{
						<button class="card-btn" @onclick="@(() => this.AccessData(context.Point))">
							<div>@count (@number %)</div>
						</button>
					}
					else
					{
						<div>-</div>
					}

				</div>
			</DxChartTooltip>
			<DxChartStackedBarSeries Color="HaveChartData.CompleteChartColor" Name="@WebAppConstantValues.ParametersWithValues" Filter="@((ParameterValueSetBase p) => p.Published.Count(el => !el.Equals("-")) != 0)"
			                         ArgumentField="@(p => p.Owner.ShortName)" ValueField="@(p => 1)"
			                         AggregationMethod="Enumerable.Sum">
				<DxChartSeriesLabel Position="RelativePosition.Inside" ShowForZeroValues="false"/>
			</DxChartStackedBarSeries>
			<DxChartStackedBarSeries Color="HaveChartData.MissingChartColor" Name="@WebAppConstantValues.ParametersWithMissingValues" Filter="@((ParameterValueSetBase p) => p.Published.Count(el => !el.Equals("-")) == 0)"
			                         ArgumentField="@(p => p.Owner.ShortName)" ValueField="@(p => 1)"
			                         AggregationMethod="Enumerable.Sum">
				<DxChartSeriesLabel Position="RelativePosition.Inside" ShowForZeroValues="false"/>
			</DxChartStackedBarSeries>
			<DxChartLegend Position="RelativePosition.Outside" HorizontalAlignment="HorizontalAlignment.Center"/>
		</DxChart>
	}
</div>