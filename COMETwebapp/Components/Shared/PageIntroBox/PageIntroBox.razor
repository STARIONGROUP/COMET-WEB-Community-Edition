@if (this.Application == null || !(this.IsPageIntroductionVisible && (!string.IsNullOrEmpty(this.summary) || this.points.Count > 0)))
{
    return;
}

<div role="note"
     aria-label="@($"{this.Application.Name} introduction")"
     class="page-intro-box">
    <div class="page-intro-box__accent"></div>
    <div class="page-intro-box__content">
        <div class="page-intro-box__header">
            <CometIcon Icon="IconName.Info" />

            <span class="page-intro-box__title">@this.Application.Name</span>
            <DxButton CssClass="page-intro-box__dismiss"
                      aria-label="@($"Dismiss introduction for {this.Application.Name}")"
                      Click="@this.DismissAsync"
                      RenderStyle="@(ButtonRenderStyle.None)">
                <CometIcon Icon="IconName.Close" />
            </DxButton>
        </div>
        @if (!string.IsNullOrEmpty(this.summary))
        {
            <p class="page-intro-box__summary">@this.summary</p>
        }
        @if (this.points.Count > 0)
        {
            <ul class="page-intro-box__points">
                @foreach (var point in this.points)
                {
                    <li>@point</li>
                }
            </ul>
        }
    </div>
</div>
