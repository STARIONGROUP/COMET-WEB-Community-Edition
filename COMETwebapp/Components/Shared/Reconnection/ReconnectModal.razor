@namespace COMETwebapp.Components.Shared.Reconnection

<div id="components-reconnect-modal" class="components-reconnect-hide comet-connection-banner">
    <ReconnectStateBanner StateClass="components-reconnect-show"
                          BadgeType="warning"
                          IsSpinner="true"
                          Title="Connection Lost"
                          Text="Network connection to the server was lost. Attempting to reconnect... Unsaved changes are preserved while retrying." />

    <ReconnectStateBanner StateClass="components-reconnect-retrying"
                          BadgeType="warning"
                          IsSpinner="true"
                          Title="Retrying Connection"
                          Text="Attempting to re-establish connection to the server... Unsaved changes are preserved while retrying." />

    <ReconnectStateBanner StateClass="components-reconnect-paused"
                          BadgeType="warning"
                          IsSpinner="false"
                          Title="Connection Paused"
                          Text="The connection has been paused. Click to resume your session."
                          ActionText="Resume Connection"
                          ActionType="ReconnectActionType.Reconnect" />

    <ReconnectStateBanner StateClass="components-reconnect-failed"
                          BadgeType="danger"
                          IsSpinner="false"
                          Title="Reconnection Failed"
                          Text="Server is unreachable. Retrying connection in a few seconds... Unsaved changes might be lost if connection cannot be restored."
                          ActionText="Retry Now"
                          ActionType="ReconnectActionType.Reconnect" />

    <ReconnectStateBanner StateClass="components-reconnect-rejected"
                          BadgeType="danger"
                          IsSpinner="false"
                          Title="Session Expired"
                          Text="The server session has expired or was terminated. Reload the page to restore your connection."
                          ActionText="Reload Page"
                          ActionType="ReconnectActionType.Reload" />
</div>