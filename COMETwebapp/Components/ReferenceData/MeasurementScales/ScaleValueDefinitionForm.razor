@inherits SelectedDataItemForm

<EditForm Context="editFormContext"
          Model="@(this.ScaleValueDefinition)"
          OnValidSubmit="@(this.OnValidSubmit)">
    <FluentValidationValidator />
    <DxFormLayout CssClass="w-100">
        <DxFormLayoutItem Caption="Shortname:"
                          ColSpanMd="10">
            <DxTextBox @bind-Text="@(this.ScaleValueDefinition.ShortName)" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="Name:"
                          ColSpanMd="10">
            <DxTextBox @bind-Text="@(this.ScaleValueDefinition.Name)" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="Value:"
                          ColSpanMd="10">
            <DxTextBox @bind-Text="@(this.ScaleValueDefinition.Value)" />
        </DxFormLayoutItem>
    </DxFormLayout>
    <FormButtons SaveButtonEnabled="@(this.IsSaveButtonEnabled(editFormContext))"
                 OnCancel="@(this.OnCancel)"
                 ValidationMessages="@(this.MapOfValidationMessages.SelectMany(x => x.Value))" />
</EditForm>
