@inherits SelectedDataItemForm

<EditForm Context="editFormContext"
          Model="@(this.Item)"
          OnValidSubmit="@(this.OnValidSubmit)">
    <FluentValidationValidator/>
    <DxFormLayout CssClass="w-100">
        <DxFormLayoutItem Caption="Shortname:" ColSpanMd="12">
            <DxTextBox Id="componentShortNameInput"
                       @bind-Text="@(this.Item.ShortName)"/>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="Parameter Type:" ColSpanMd="12">
            <DxComboBox Id="componentParameterTypeInput"
                        Data="@(this.ParameterTypes.OrderBy(x => x.Name))"
                        TextFieldName="@(nameof(ParameterType.Name))"
                        NullText="Select a parameter type"
                        TextChanged="@(() => this.Item.Scale = null)"
                        @bind-Value="@(this.Item.ParameterType)"/>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="Scale:" ColSpanMd="12">
            <DxComboBox Id="componentScaleInput"
                        Data="@(this.GetAvailableScales())"
                        TextFieldName="@(nameof(MeasurementScale.Name))"
                        @bind-Value="@(this.Item.Scale)"/>
        </DxFormLayoutItem>
    </DxFormLayout>
    <FormButtons SaveButtonEnabled="@(this.IsSaveButtonEnabled(editFormContext))"
                 OnCancel="@(this.OnCancel)"
                 ValidationMessages="@(this.MapOfValidationMessages.SelectMany(x => x.Value))"/>
</EditForm>
