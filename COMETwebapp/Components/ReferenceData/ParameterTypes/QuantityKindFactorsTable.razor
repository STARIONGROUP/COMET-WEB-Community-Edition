@inherits ThingOrderedItemsTable<DerivedQuantityKind, QuantityKindFactor, QuantityKindFactorRowViewModel>

<DxGrid Data="this.GetRows()">
    <Columns>
        <DxGridDataColumn FieldName="@nameof(QuantityKindFactorRowViewModel.Exponent)" MinWidth="80"/>
        <DxGridDataColumn FieldName="@nameof(QuantityKindFactorRowViewModel.QuantityKind)"/>
        <DxGridCommandColumn Width="100px">
            <HeaderTemplate>
                <DxButton Id="addQuantityKindFactorButton" Text="Add" IconCssClass="@IconName.Add.GetCssClass()" Click="this.StartCreate" Enabled="@(!this.IsReadOnly)" RenderStyle="@(CometButtonStyle.Primary.ToButtonRenderStyle())"/>
            </HeaderTemplate>
            <CellDisplayTemplate>
                @{
                    var row = (QuantityKindFactorRowViewModel)context.DataItem;

                    <DxButton Id="editQuantityKindFactorButton"
                              IconCssClass="@IconName.Edit.GetCssClass()"
                              Click="@(() => this.StartEdit(row))"
                              RenderStyle="@(CometButtonStyle.Edit.ToButtonRenderStyle())"/>

                    <DxButton Id="removeQuantityKindFactorButton"
                              IconCssClass="@IconName.Delete.GetCssClass()"
                              Click="@(() => this.RemoveItem(row))"
                              Enabled="@(!this.IsReadOnly && row.IsAllowedToWrite)"
                              RenderStyle="@(CometButtonStyle.Danger.ToButtonRenderStyle())"/>
                }
            </CellDisplayTemplate>
        </DxGridCommandColumn>
        <DxGridCommandColumn Width="100px">
            <HeaderTemplate>
                Order
            </HeaderTemplate>
            <CellDisplayTemplate>
                @{
                    var row = (QuantityKindFactorRowViewModel)context.DataItem;

                    <DxButton Id="moveUpButton"
                              IconCssClass="@IconName.ArrowUp.GetCssClass()"
                              Click="() => this.MoveUp(row)"
                              Enabled="@(this.Thing.QuantityKindFactor.IndexOf(row.Thing) > 0 && !this.IsReadOnly)"
                              RenderStyle="@(CometButtonStyle.Light.ToButtonRenderStyle())"/>

                    <DxButton Id="moveDownButton"
                              IconCssClass="@IconName.ArrowDown.GetCssClass()"
                              Click="() => this.MoveDown(row)"
                              Enabled="@(this.Thing.QuantityKindFactor.LastOrDefault() != row.Thing && !this.IsReadOnly)"
                              RenderStyle="@(CometButtonStyle.Light.ToButtonRenderStyle())"/>
                }
            </CellDisplayTemplate>
        </DxGridCommandColumn>
    </Columns>
</DxGrid>

<DxPopup HeaderText="Quantity Kind Factor"
         @bind-Visible="@this.IsOnEditMode"
         CloseOnOutsideClick="false">
    <BodyContentTemplate Context="popupContext">
        <QuantityKindFactorForm Item="@this.Item"
                                QuantityKindParameterTypes="@this.QuantityKindParameterTypes"
                                ShouldCreate="@this.ShouldCreate"
                                IsVisible="@this.IsOnEditMode"
                                IsVisibleChanged="@(visible => this.IsOnEditMode = visible)"
                                OnSaved="@this.OnSaved"
                                OnCanceled="@this.OnCanceled"/>
    </BodyContentTemplate>
</DxPopup>