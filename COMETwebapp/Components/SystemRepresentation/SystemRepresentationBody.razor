@inherits COMET.Web.Common.Components.Applications.SingleIterationApplicationBase<COMETwebapp.ViewModels.Components.SystemRepresentation.ISystemRepresentationBodyViewModel>

<LoadingComponent IsVisible="@(this.ViewModel.IsLoading)">
    <div id="gridParent">
        <div id="leftColumn">
            <div id="option-filter">
                <OptionSelector ViewModel="this.ViewModel.OptionSelector"/>
            </div>
            <SystemRepresentationTree ViewModel="this.ViewModel.ProductTreeViewModel" />
        </div>
        <div id="col-resizer" title="Drag to resize"></div>
        <div id="rightColumn">
            <ElementDetailsPanel ViewModel="this.ViewModel.DetailsPanelViewModel" />
        </div>
    </div>
</LoadingComponent>
