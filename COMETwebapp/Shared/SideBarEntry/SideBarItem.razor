<div class="application-item-container @(this.CssClass)" @onclick="@(this.ExecuteAction)" @onkeydown="@(this.HandleKeyDown)" tabindex="@(this.Enabled ? 0 : -1)" role="button" aria-disabled="@((!this.Enabled).ToString().ToLowerInvariant())" aria-current="@(this.Selected ? "page" : null)" id="@(this.Id)" title="@(this.Text)">

    @if (this.ChildContent is not null)
    {
        @(this.ChildContent)
    }
    else
    {
        <div class="application-item-content">
            @if (this.Icon is not null)
            {
                <div class="application-sidebar-icon">
                    <CometIcon Icon="@(this.Icon.Value)" Size="22" CssClass="cursor-pointer"/>
                </div>
            }
            else
            {
                <span class="@(this.IconCssClass) display-flex justify-content-center application-sidebar-icon" id="side-bar-item-css-icon" aria-hidden="true"></span>
            }
            <span class="not-displayed-on-collapse">@(this.Text)</span>
        </div>
        if (this.DropdownSelector)
        {
            <div style="margin-left: auto;" class="not-displayed-on-collapse">
                <CometIcon Icon="IconName.ChevronRight" Size="15"/>
            </div>
        }
    }
</div>
