@using COMET.Web.Common.Shared.TopMenuEntry

<DxLayoutBreakpoint MaxWidth="1200" @bind-IsActive="@this.IsNarrowViewport"/>

<nav id="main-side-bar" tabindex="-1" class="@($"{(this.IsCollapsed ? "collapsed" : "")} main-side-bar")" aria-label="Main navigation" aria-keyshortcuts="Alt+Shift+N">
    <div class="@(this.IsCollapsed ? "text-center" : "text-end")">
        <DxButton Text="Collapse"
                  Click="@this.ToggleCollapsed"
                  RenderStyle="@(CometButtonStyle.None.ToButtonRenderStyle())"
                  Id="side-bar-collapse-button"
                  aria-keyshortcuts="Alt+Shift+B"
                  aria-label="@(this.IsCollapsed ? "Expand navigation" : "Collapse navigation")">
            @if (this.IsCollapsed)
            {
                <CometIcon Icon="IconName.ArrowRight" Size="24"/>
            }
            else
            {
                <CometIcon Icon="IconName.ArrowLeft" Size="24"/>
            }
        </DxButton>
    </div>

    @foreach (var menuEntry in this.RegistrationService.RegisteredAuthorizedMenuEntries.Where(x => x.IsSubclassOf(typeof(MenuEntryBase))))
    {
        <DynamicComponent Type="@menuEntry"/>
    }
</nav>